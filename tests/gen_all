#!/bin/sh
# gen_all: create or update expected mrun output snapshots.
MRUN="../mrun.py"
MRUN_FLAGS="-q --assume-trusted -y"
cd "$(dirname "$0")" || exit 1

mkdir -p "expected" || exit 1

# If no args provided, default to all json configs
[ "$1" ] || set -- ./conf/*.json
set -u

for cfg in "$@"; do
    [ -f "$cfg" ] || { echo "WARN: skipping missing file: $cfg" >&2; continue; }
    
    out="expected/$(basename "$cfg").out"
    {
        rc=0
        $MRUN $MRUN_FLAGS -m "$cfg" < /dev/null || rc=$?
        echo "exit=$rc"
    } > "$out" 2>&1
    
    echo "updated $out"
done