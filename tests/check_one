#!/bin/sh
# check_one: run mrun on a single config and diff against expected output.
MRUN="../mrun.py"
MRUN_FLAGS="-q -T --assume-trusted -y"
cd "$(dirname "$0")" || exit 1

mkdir -p "actual" || exit 1

cfg="$1"
if [ ! -f "$cfg" ]; then
    echo "ERROR: missing file: $cfg" >&2
    exit 1
fi

base="$(basename "$cfg")"
expected="expected/${base}.out"
actual="actual/${base}.out"

# 1. Check if the golden snapshot exists
if [ ! -f "$expected" ]; then
    echo "FAIL: $cfg (no expected snapshot found. Run ./gen_all first?)" >&2
    exit 1
fi

# 2. Run mrun and capture actual output
{
    rc=0
    $MRUN $MRUN_FLAGS -m "$cfg" < /dev/null || rc=$?
    echo "exit=$rc"
} > "$actual" 2>&1

# 3. Compare actual vs expected
if diff -u "$expected" "$actual" > /dev/null 2>&1; then
    rm -f "$actual" # Clean up on success
    exit 0
else
    echo "FAIL: $cfg" >&2
    # Print the unified diff to stderr so the user sees what changed
    diff -u "$expected" "$actual" >&2
    exit 1
fi
