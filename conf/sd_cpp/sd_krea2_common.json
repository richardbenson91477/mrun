  "description": "SD - Krea2 (Common)",
  "include": "sd_common.json",
  "vars": {
    "_": "<lora:lora_refusal_reduction:0.8><lora:lora_unlocked:0.8>"
  },
  "args": {
    "--vae": "{_model_path}/krea2_models/vae_krea2",
