{
  "name": "ll_sentence_gen",
  "kind": "mode",
  "description": "Llama.cpp Sentence Gen",
  "vars": {
    "_mrun_path": "@mrun_env mrun_path",
    "_prompt_head": "Write a sentence using the following terms:",
    "_prompt_terms": ["cat", "food", "mouse"],
    "_prompt_tail": "Please respond in a single line with no extra information.",
    "_model_ol": "ll_ol_qwen3_5_4b_a",
    "_ctx_size": 1024,
    "_out_path": "/dev/null"
  },
  "env": {
    "conf_prompt_head": "{_prompt_head}",
    "conf_prompt_terms": "{_prompt_terms}",
    "conf_prompt_tail": "{_prompt_tail}",
    "conf_model_ol": "{_model_ol}",
    "conf_ctx_size": "{_ctx_size}",
    "conf_out_path": "{_out_path}"
  },
  "executable": "{_mrun_path}/workflow_bin/ll_sentence_gen.sh"
}

