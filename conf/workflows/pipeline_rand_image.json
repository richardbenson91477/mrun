{
  "name": "pipeline_rand_image",
  "kind": "mode",
  "description": "Pipeline: Random Sentence -> Image Gen",
  "vars": {
    "_mrun_path": "@mrun_env mrun_path",
    "_prompt_file": "/tmp/pipeline_rand_image_prompt",
    "_image_out_path": "/tmp/pipeline_rand_image_out.png",
    "_auto": "true",
    "_image_gen_mode": "sd_moss_i"
  },
  "env": {
    "_mrun_prompt_file": "{_prompt_file}",
    "_mrun_image_out_path": "{_image_out_path}",
    "_mrun_auto": "{_auto}",
    "_mrun_image_gen_mode": "{_image_gen_mode}"
  },
  "executable": "{_mrun_path}/workflows/pipeline_rand_image.sh"
}
