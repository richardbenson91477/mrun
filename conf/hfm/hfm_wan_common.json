{
  "name": "hfm_wan_common",
  "kind": "base",
  "description": "HFM - Wan (Common)",
  "vars": {
    "_hfm_path": "@mrun_env hfm_path",
    "_model_path": "@mrun_env lena_model_path"
  },
  "executable": "{_hfm_path}/hfm_wan_cli.py",
  "args": {
    "--frames_n": 21,
    "--guidance_scale": 1.0,
    "--flow_shift": 7.0,
    "--scheduler_type": "upcm",
    "--quality": 9.5,
    "--seed": 86,
    "--steps": 4,
    "--width": 640,
    "--height": 480,
    "--fps": 15.0,
    "--style": "video",
    "--negative_prompt": "worst quality, low quality, blurry, distorted, artifacts"
  }
}

