#!/bin/sh

[ "$nw" ] ||\
  nw=3

[ "$1" = "--help" ] && {
    echo "usage: $0 [mrun extra args]"
    echo "env:"
    echo "  nw: number of random words to generate (current: ${nw})"
    exit 1
    }


random_words=$(zstdcat $mrun_path/etc/words.zst |
      shuf |
      head -n "$nw"
      )


mrun -m "ll_sentence_gen" -y -- \
  --var _prompt_terms="@mrun_list ${random_words}" \
  "$@"

