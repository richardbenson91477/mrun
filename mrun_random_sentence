#!/bin/sh

_num_words_default=3
_words_path_default="$mrun_path/etc/words.zst"
_out_path_default="/tmp/mrun_random_sentence.out"

[ "$num_words" ] ||\
  num_words="$_num_words_default"

[ "$words_path" ] ||\
  words_path="$_words_path_default"

[ "$out_path" ] ||\
  out_path="$_out_path_default"


[ "$1" = "--help" ] && {
    echo "usage: $0 [mrun extra args]"
    echo "env:"
    echo "  num_words: number of random words to generate (current: ${num_words})"
    echo "  words_path: path to zstd compressed words list (current: \"${words_path}\")"
    echo "  out_path: path to save generated response (current: \"${out_path}\")"
    exit 1
    }


generate_random_words () {
    random_words=$(zstdcat "$words_path" |
          shuf |
          head -n "$num_words"
          )
    }


if [ "$1" != "-y" ]; then
    _confirm="n"
    while [ "$_confirm" = "n" ]; do
        generate_random_words

        echo -n "$(basename $0): use random words: $(echo -n ${random_words})"
        read -p "$@? (y/n/q): " _confirm
        [ "$_confirm" = "q" ] &&\
          exit 2

        done

  else
    generate_random_words
    shift
    fi


mrun -m "ll_sentence_gen" -y -- \
  --var _prompt_terms="@mrun_list ${random_words}" \
  --var _out_path="$out_path" \
  "$@"

